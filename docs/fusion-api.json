{
  "$schema_note": "Reverse-engineered/documented REST API for Nevion/Macnica 'Fusion' ST2110 UHD transceiver devices (emSFP platform). Compiled from js/fusionFunctions.js and js/flowEditorFunctions.js plus live exploration of a production device (self-describing API: any collection path without a trailing ID returns the list of its children).",
  "device_family": {
    "vendor": "Macnica (Nevion emSFP platform)",
    "product_line": "MN-FusioN-6-B (ST2110 UHD Transceiver, 6x SDI <-> ST2110)",
    "management": "NMOS IS-04/IS-05 capable, plus this proprietary REST API",
    "example_device": {
      "hostname": "CS6.IP/HI 01",
      "serial_number": "126031200127",
      "firmware": "4.8.1",
      "verified_against_ip": "10.102.4.158",
      "verified_on": "2026-09-15"
    }
  },
  "base_url": "http://<device-ip>/emsfp/node/v1",
  "transport_notes": {
    "content_type": "application/json (requests sent as raw JSON string body via JSON.stringify, not form-encoded)",
    "cors": "Access-Control-Allow-Origin: * ; Allow-Methods: GET, PUT, POST, PATCH, HEAD, OPTIONS, DELETE",
    "quirk": "POST responses are sometimes non-JSON (plain text 'ok') or trigger a CORS-classified failure in the browser even though the write succeeded server-side. Client code treats xhr failure with responseText 'ok' as success.",
    "self_describing": "GET on any collection path without an ID (e.g. /flows/, /sdi_output/) returns a JSON array of child IDs/paths, which can be fetched individually. GET on a bare container path (e.g. /self/, /self/diag/) returns an array of sub-resource names."
  },
  "discovery_tree": {
    "description": "Result of GET on every path with no ID, giving the full known resource tree as of the verification date.",
    "/emsfp/": ["node/"],
    "/emsfp/node/": ["v1/"],
    "/emsfp/node/v1/": ["self/", "port/", "flows/", "sources/", "receivers/", "senders/", "route/", "devices/", "sdi/", "sdi_output/", "sdi_input/", "sdi_audio/", "sdp/", "receivers_sdp/", "senders_sdp/", "clean_switch/", "refclk/", "lldp/", "telemetry/"],
    "/emsfp/node/v1/self/": ["information/", "diag/", "firmware/", "phy/", "interfaces/", "ipconfig/", "static_route/", "license/", "system/", "syslog/", "protocols/"],
    "/emsfp/node/v1/self/diag/": ["common/", "firmware/", "dns/", "flow/", "packet_interval_time/", "devices/", "2110-7_engine/", "refclk/", "nmos/"],
    "/emsfp/node/v1/route/": ["bulk/"],
    "/emsfp/node/v1/route/bulk/": ["sender/", "receiver/"],
    "/emsfp/node/v1/telemetry/": ["node/", "ports/", "devices/", "warnings/"]
  },
